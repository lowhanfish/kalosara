generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  LURAH
  ADMIN_KELURAHAN
  MASYARAKAT
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(254)
  phone               String?              @unique @db.VarChar(20)
  passwordHash        String               @db.VarChar(255)
  role                Role                 @default(MASYARAKAT)
  isActive            Boolean              @default(true)
  verifiedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  news                News[]
  media               MediaAsset[]
  profile             UserProfile?
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")

  @@index([role, isActive])
}

model UserProfile {
  userId      String   @id @db.Uuid
  displayName String?  @db.VarChar(120)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  userAgent String?   @db.VarChar(255)
  ipHash    String?   @db.Char(64)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String?  @db.VarChar(100)
  resourceId   String?  @db.VarChar(100)
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([createdAt])
}

// One installation, one kelurahan. No tenant identifier.
model SiteSetting {
  id        String   @id @default("site")
  value     Json
  updatedAt DateTime @updatedAt
}

model Page {
  slug      String   @id @db.VarChar(60)
  title     String   @db.VarChar(160)
  content   String   @db.Text
  status    String   @default("DRAFT") @db.VarChar(20)
  updatedAt DateTime @updatedAt
}

model Official {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  position  String   @db.VarChar(160)
  unit      String   @db.VarChar(160)
  sortOrder Int      @default(0)
  photoUrl  String?  @db.VarChar(500)
  active    Boolean  @default(true)
  termStart DateTime? @db.Date
  termEnd   DateTime? @db.Date
  status    String   @default("DRAFT") @db.VarChar(20)
  updatedAt DateTime @updatedAt
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

model NewsCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(120)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      News[]
}

model News {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(180)
  title       String   @db.VarChar(200)
  excerpt     String   @db.VarChar(1000)
  bodyHtml    String   @db.Text
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  version     Int      @default(1)
  authorId    String   @db.Uuid
  categoryId  String   @db.Uuid
  coverId     String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category    NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cover       MediaAsset? @relation("NewsCover", fields: [coverId], references: [id], onDelete: Restrict)
  media       NewsMedia[]
  revisions   NewsRevision[]

  @@index([status, updatedAt])
  @@index([categoryId, status])
}

model NewsRevision {
  id        String   @id @default(uuid()) @db.Uuid
  newsId    String   @db.Uuid
  version   Int
  editorId  String   @db.Uuid
  snapshot  Json
  mediaIds  String[]
  createdAt DateTime @default(now())
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, version])
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  storageKey   String   @unique @db.VarChar(100)
  originalName String   @db.VarChar(200)
  mimeType     String   @db.VarChar(100)
  size         Int
  alt          String   @db.VarChar(300)
  caption      String   @db.VarChar(1000)
  visibility   MediaVisibility @default(PRIVATE)
  archived     Boolean  @default(false)
  ownerId      String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  covers       News[]   @relation("NewsCover")
  news         NewsMedia[]

  @@index([visibility, archived, createdAt])
  @@index([ownerId])
}

model NewsMedia {
  newsId  String @db.Uuid
  mediaId String @db.Uuid
  news    News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([newsId, mediaId])
}
