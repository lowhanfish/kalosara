generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  LURAH
  ADMIN_KELURAHAN
  MASYARAKAT
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(254)
  phone               String?              @unique @db.VarChar(20)
  passwordHash        String               @db.VarChar(255)
  role                Role                 @default(MASYARAKAT)
  isActive            Boolean              @default(true)
  verifiedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  news                News[]
  media               MediaAsset[]
  contactChange       ContactChange?
  profile             UserProfile?
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  letters             LetterRequest[]

  @@index([role, isActive])
}

model UserProfile {
  userId      String   @id @db.Uuid
  displayName String?  @db.VarChar(120)
  address     String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  userAgent String?   @db.VarChar(255)
  ipHash    String?   @db.Char(64)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String?  @db.VarChar(100)
  resourceId   String?  @db.VarChar(100)
  requestId    String?  @db.VarChar(36)
  ipHash       String?  @db.Char(64)
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([createdAt])
}

// One installation, one kelurahan. No tenant identifier.
model SiteSetting {
  id        String   @id @default("site")
  value     Json
  updatedAt DateTime @updatedAt
}

model Page {
  slug      String   @id @db.VarChar(60)
  title     String   @db.VarChar(160)
  content   String   @db.Text
  status    String   @default("DRAFT") @db.VarChar(20)
  updatedAt DateTime @updatedAt
}

model Official {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  position  String   @db.VarChar(160)
  unit      String   @db.VarChar(160)
  sortOrder Int      @default(0)
  photoUrl  String?  @db.VarChar(500)
  active    Boolean  @default(true)
  termStart DateTime? @db.Date
  termEnd   DateTime? @db.Date
  status    String   @default("DRAFT") @db.VarChar(20)
  updatedAt DateTime @updatedAt
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

model NewsCategory {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(120)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  news      News[]
}

model News {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(180)
  title       String   @db.VarChar(200)
  excerpt     String   @db.VarChar(1000)
  bodyHtml    String   @db.Text
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  version     Int      @default(1)
  authorId    String   @db.Uuid
  categoryId  String   @db.Uuid
  coverId     String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category    NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cover       MediaAsset? @relation("NewsCover", fields: [coverId], references: [id], onDelete: Restrict)
  media       NewsMedia[]
  revisions   NewsRevision[]
  slugAliases NewsSlugAlias[]

  @@index([status, updatedAt])
  @@index([categoryId, status])
}

model NewsRevision {
  id        String   @id @default(uuid()) @db.Uuid
  newsId    String   @db.Uuid
  version   Int
  editorId  String   @db.Uuid
  snapshot  Json
  mediaIds  String[]
  createdAt DateTime @default(now())
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, version])
}

model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  storageKey   String   @unique @db.VarChar(100)
  originalName String   @db.VarChar(200)
  mimeType     String   @db.VarChar(100)
  size         Int
  alt          String   @db.VarChar(300)
  caption      String   @db.VarChar(1000)
  visibility   MediaVisibility @default(PRIVATE)
  archived     Boolean  @default(false)
  ownerId      String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  facilities Facility[]
  potentials Potential[]
  galleryPhotos GalleryPhoto[]
  documents PublicDocument[]
  covers       News[]   @relation("NewsCover")
  news         NewsMedia[]

  @@index([visibility, archived, createdAt])
  @@index([ownerId])
}

model NewsMedia {
  newsId  String @db.Uuid
  mediaId String @db.Uuid
  news    News @relation(fields: [newsId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([newsId, mediaId])
}

model NewsSlugAlias {
  slug      String   @id @db.VarChar(180)
  newsId    String   @db.Uuid
  createdAt DateTime @default(now())
  news      News     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  @@index([newsId])
}

// Transactional delivery record, drained by the existing API process (no queue service).
model CacheInvalidation {
  id            String    @id @default(uuid()) @db.Uuid
  tags          String[]
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  @@index([deliveredAt, nextAttemptAt])
}

enum ContentKind {
  announcements
  events
  galleries
  documents
}

// Shared lifecycle; each channel has a typed one-to-one payload.
model ContentItem {
  id String @id @default(uuid()) @db.Uuid
  kind ContentKind
  title String @db.VarChar(200)
  content String @db.Text
  status PublicationStatus @default(DRAFT)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  announcement Announcement?
  event Event?
  gallery Gallery?
  document PublicDocument?
  @@index([kind, status, updatedAt])
}
model Announcement {
  contentId String @id @db.Uuid
  pinned Boolean @default(false)
  startsAt DateTime?
  expiredAt DateTime?
  item ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
}
model Event {
  contentId String @id @db.Uuid
  start DateTime
  end DateTime
  location String @db.VarChar(300)
  item ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  @@index([start, end])
}
model Gallery {
  contentId String @id @db.Uuid
  item ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  photos GalleryPhoto[]
}
model GalleryPhoto {
  galleryId String @db.Uuid
  mediaId String @db.Uuid
  alt String @db.VarChar(300)
  sortOrder Int
  gallery Gallery @relation(fields: [galleryId], references: [contentId], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  @@id([galleryId, mediaId])
}
model PublicDocument {
  contentId String @id @db.Uuid
  category String @db.VarChar(120)
  classification String? @db.VarChar(20)
  fileId String @db.Uuid
  item ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  file MediaAsset @relation(fields: [fileId], references: [id], onDelete: Restrict)
}

// Aggregate statistics only: no resident identities or household identifiers.
model StatisticSnapshot {
  id String @id @default(uuid()) @db.Uuid
  period String @unique @db.VarChar(7)
  source String @db.VarChar(300)
  referenceDate DateTime @db.Date
  population Int?
  male Int?
  female Int?
  households Int?
  rt Int?
  rw Int?
  status PublicationStatus @default(DRAFT)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, period])
}

model Facility {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(160)
  description String @db.Text
  category String @db.VarChar(100)
  location String @db.VarChar(300)
  latitude Float?
  longitude Float?
  photoId String? @db.Uuid
  photoAlt String @db.VarChar(300)
  status PublicationStatus @default(DRAFT)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photo MediaAsset? @relation(fields: [photoId], references: [id], onDelete: Restrict)
  @@index([status, category])
}

model Potential {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(160)
  description String @db.Text
  category String @db.VarChar(100)
  location String @db.VarChar(300)
  latitude Float?
  longitude Float?
  photoId String? @db.Uuid
  photoAlt String @db.VarChar(300)
  status PublicationStatus @default(DRAFT)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photo MediaAsset? @relation(fields: [photoId], references: [id], onDelete: Restrict)
  @@index([status, category])
}


// One pending request per account. Canonical contacts change only after verification.
model ContactChange {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  newEmail        String?  @db.VarChar(254)
  newPhone        String?  @db.VarChar(20)
  baseContactHash String   @db.Char(64)
  requestedAt     DateTime @default(now())
  expiresAt       DateTime
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

// Private messages from public complaint and PPID forms. Never exposed by public listings.
model PublicRequest {
  id String @id @default(uuid()) @db.Uuid
  kind String @db.VarChar(20)
  name String @db.VarChar(120)
  organization String? @db.VarChar(200)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(30)
  subject String @db.VarChar(200)
  message String @db.Text
  status String @default("NEW") @db.VarChar(20)
  internalNote String @default("") @db.Text
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([kind, status, createdAt])
}

enum GuestStatus {
  WAITING
  SERVED
  CANCELLED
}

// Digital guestbook entries for office visits. Private, accessible only by staff and leadership.
model GuestBookEntry {
  id               String      @id @default(uuid()) @db.Uuid
  ticketNumber     String      @unique @db.VarChar(30)
  fullName         String      @db.VarChar(120)
  phone            String      @db.VarChar(30)
  nik              String?     @db.VarChar(20)
  guestType        String      @db.VarChar(30)
  institution      String?     @db.VarChar(200)
  addressOrRt      String?     @db.VarChar(200)
  purpose          String      @db.VarChar(200)
  destinationStaff String      @db.VarChar(200)
  notes            String?     @db.Text
  status           GuestStatus @default(WAITING)
  servedAt         DateTime?
  servedBy         String?     @db.VarChar(120)
  internalNote     String      @default("") @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}

enum LetterType {
  SKU
  SKTM
  DOMISILI
  PENGANTAR_SKCK
  BELUM_MENIKAH
  BELUM_BEKERJA
  PENGHASILAN
  PENGANTAR_NIKAH
  AHLI_WARIS
  LAINNYA
}

enum LetterStatus {
  SUBMITTED
  REJECTED
  VERIFIED
  SIGNED
}

model LetterRequest {
  id               String             @id @default(uuid()) @db.Uuid
  ticketNumber     String             @unique @db.VarChar(30)
  letterNumber     String?            @unique @db.VarChar(60)
  type             LetterType
  status           LetterStatus       @default(SUBMITTED)
  userId           String             @db.Uuid
  applicantName    String             @db.VarChar(120)
  applicantNik     String             @db.VarChar(20)
  birthPlace       String             @db.VarChar(100)
  birthDate        String             @db.VarChar(20)
  gender           String             @db.VarChar(20)
  religion         String             @db.VarChar(30)
  maritalStatus    String             @db.VarChar(30)
  occupation       String             @db.VarChar(100)
  address          String             @db.VarChar(500)
  details          Json
  rejectionReason  String?            @db.Text
  verifiedAt       DateTime?
  verifiedBy       String?            @db.VarChar(120)
  signedAt         DateTime?
  signedBy         String?            @db.VarChar(120)
  pdfPath          String?            @db.VarChar(500)
  qrToken          String?            @unique @db.VarChar(64)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments      LetterAttachment[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model LetterAttachment {
  id           String        @id @default(uuid()) @db.Uuid
  letterId     String        @db.Uuid
  originalName String        @db.VarChar(255)
  storagePath  String        @db.VarChar(500)
  fileSize     Int
  mimeType     String        @db.VarChar(100)
  createdAt    DateTime      @default(now())
  letter       LetterRequest @relation(fields: [letterId], references: [id], onDelete: Cascade)

  @@index([letterId])
}
