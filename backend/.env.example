NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
LOG_LEVEL=info
PASSWORD_BCRYPT_COST=12
APP_ORIGIN=http://localhost:3000
# Generate a 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SIGNING_KEYS=v1:<base64url-key>

# File fisik dikelompokkan berdasarkan asal upload; akses tetap melalui API
UPLOAD_ROOT=public/uploads

FRONTEND_INTERNAL_URL=http://localhost:3000
# Shared server-only random secret (at least 32 chars); same value on frontend
# CACHE_INVALIDATION_SECRET=<random-secret>
