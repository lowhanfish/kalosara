    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^21.3.4",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
