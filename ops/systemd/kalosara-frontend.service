[Unit]
Description=KALOSARA standalone frontend
After=network-online.target kalosara-backend.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=kalosara
Group=kalosara
WorkingDirectory=/srv/kalosara/current/frontend
EnvironmentFile=/etc/kalosara/frontend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=512 server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=768M
CPUQuota=80%
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kalosara/current/frontend/.next
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SyslogIdentifier=kalosara-frontend

[Install]
WantedBy=multi-user.target
