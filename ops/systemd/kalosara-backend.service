[Unit]
Description=KALOSARA native API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=kalosara
Group=kalosara
WorkingDirectory=/srv/kalosara/current/backend
EnvironmentFile=/etc/kalosara/backend.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node --max-old-space-size=384 dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=512M
CPUQuota=80%
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kalosara/shared/uploads
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SyslogIdentifier=kalosara-backend

[Install]
WantedBy=multi-user.target
