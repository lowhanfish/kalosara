POSTGRES_PASSWORD=replace-with-a-strong-local-password
HTTP_PORT=8080
APP_ORIGIN=http://localhost:8080
# Required by backend in Docker. Generate a random 32-byte base64url key and prepend v1:
# AUTH_SIGNING_KEYS=v1:<base64url-key>

# Required by both applications in Compose; separate from AUTH_SIGNING_KEYS
# CACHE_INVALIDATION_SECRET=<random-secret-at-least-32-chars>
