{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-build",
    "incremental": false,
    "isolatedModules": true,
    "types": [
      "node",
      "next"
    ]
  },
  "include": [
    "services/http-client.ts",
    "store/auth-store.ts",
    "features/auth/runtime.ts",
    "lib/site-settings.ts",
    "lib/public-pages.ts",
    "lib/news-seo.ts",
    "lib/cache-signature.ts",
    "lib/region.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
